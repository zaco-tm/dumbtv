# Single source of truth for the fork's version.
#
# VERSION_NAME and VERSION_CODE must match variant/AndroidManifest.xml, and
# release-check.sh says so out loud when they do not: an APK whose manifest says
# one version and a version file that says another is how an update gets refused
# on the television.
#
# Change all three together, then build:
#
#   ./variant/build.sh
#
VERSION=1.0
VERSION_CODE=1
VERSION_NAME=1.0

# The old launcher (tv.dumbtv.home) is not built or shipped from this repo any
# more. It stays installed on a television as the fallback, and
# ./variant/install.sh --undo hands HOME back to it.
#
# Its APK comes from the upstream release, not from here, so its version and hash
# are kept here and checked by release-check.sh --remote: the fallback is only
# worth having if the file it comes from is the file that was checked.
#
# 1.6 is upstream's newest launcher release. Its guard label is still "dumbtv home
# button", which is what the scripts look for, so the fallback stays tellable apart
# from AverageTV's own guard ("AverageTV guard").
FALLBACK_VERSION=1.6
FALLBACK_APK_SHA256=9e0f95ed141a980295eba0649ee2f7d1d8b49eacced31246bd2445d92954fdd9
